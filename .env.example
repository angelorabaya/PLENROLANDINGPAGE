# ============================================================
# PLENRO Misamis Oriental — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to version control.
# ============================================================

# REQUIRED: Server-side Gemini API key.
# Create one at https://aistudio.google.com/apikey
# Used ONLY by the Cloudflare Pages Function (functions/api/chat.js).
# Do NOT prefix with NEXT_PUBLIC_ — it is a server-only secret.
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Comma-separated Gemini model IDs to try, in priority order.
# Defaults (if unset): gemini-2.5-flash, gemini-2.0-flash, gemini-2.0-flash-lite, gemini-1.5-flash
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# OPTIONAL: Cloudflare Web Analytics token (privacy-friendly, cookie-less).
# Get it from your Cloudflare dashboard → Web Analytics.
# Public value; inlined into the client bundle at build time.
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# ------------------------------------------------------------------
# OPTIONAL: Facebook Page feed carousel (Latest Activities section).
# See docs/facebook-feed-setup.md for the full App + token walkthrough.
# These are server-side only secrets (used by functions/api/facebook-posts.js
# and the dev-only route handler).
# ------------------------------------------------------------------
# FACEBOOK_PAGE_ID=789005134298348
# FACEBOOK_ACCESS_TOKEN=EAAG...

# OPTIONAL: Only relevant for local `wrangler pages dev` with a KV namespace.
# When a KV namespace is bound as RATE_LIMIT_KV in the Cloudflare dashboard /
# wrangler.toml, per-IP rate limiting becomes durable across isolates.

# ------------------------------------------------------------------
# OPTIONAL: Cloudflare Turnstile bot protection for the contact form.
# Create the site + secret at https://dash.cloudflare.com/?to=/:account/turnstile
# The site key is public (inlined client-side); the secret is server-side only.
# Set BOTH together — if the secret is set without the site key the form rejects.
# ------------------------------------------------------------------
# NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY=0x4AAAA...
# CF_TURNSTILE_SECRET_KEY=0x4AAAA...
